{
  "name": "codeshop",
  "private": true,
  "description": "扫码导购商城：线下体验、线上成交，订单按服务记录归属到门店和导购",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm -r --filter ./apps/** build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "dev:server": "pnpm --filter @codeshop/server dev",
    "dev:merchant": "pnpm --filter @codeshop/merchant-web dev",
    "dev:platform": "pnpm --filter @codeshop/platform-web dev",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
