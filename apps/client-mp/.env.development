# 配置文档：https://taro-docs.jd.com/docs/next/env-mode-config
# 只有 TARO_APP_ 开头的变量会注入到代码里。

# 小程序 AppID（不填则使用测试号）
# TARO_APP_ID=

# 服务端地址。H5 预览留空（走 devServer 代理）；微信开发者工具里调试填 http://localhost:3000，
# 并在「详情 → 本地设置」勾选「不校验合法域名」。
TARO_APP_API_BASE=

# 开发用登录：以哪位演示顾客的身份访问服务端（服务端需 AUTH_MODE=dev）。接入 wx.login 后删除。
TARO_APP_DEV_CUSTOMER_ID=cu_alice
