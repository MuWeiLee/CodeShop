# 复制为 .env 后按需修改。.env 不入库。

# 端口
PORT=3000

# 数据库。不填则使用内嵌的 PGlite，数据保存在 PGLITE_DATA_DIR，适合本地开发。
# DATABASE_URL=postgres://codeshop:codeshop@localhost:5432/codeshop
PGLITE_DATA_DIR=.pgdata

# 导购动态码签名密钥，至少 32 个字符。生产环境必填；开发环境不填会临时生成（重启后旧码失效）。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GUIDE_CODE_SECRET=

# 二维码链接前缀，需与小程序配置的「扫普通链接二维码打开小程序」规则一致。生产环境必填。
QR_BASE_URL=https://example.com

# 登录方式。dev：用请求头 x-dev-customer-id / x-dev-guide-id / x-dev-merchant-id 模拟登录，仅限本地开发；
# none：未接入正式登录前，所有需要登录的接口都返回 401。生产环境禁止使用 dev。
AUTH_MODE=dev

# 导购开单生成的订单码有效期（分钟）
ORDER_CODE_TTL_MINUTES=30
